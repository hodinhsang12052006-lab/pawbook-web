<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs). Bản ký App Store tự đổi thành "production" theo provisioning profile.
	     App ID com.bitpawos.app phải bật "Push Notifications" trên developer.apple.com. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: link www.bitpawos.com mở thẳng trong app. App ID phải bật
	     "Associated Domains"; máy chủ phục vụ /.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.bitpawos.com</string>
	</array>
</dict>
</plist>
