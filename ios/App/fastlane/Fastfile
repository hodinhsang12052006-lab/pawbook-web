require "base64"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Build signed .ipa and upload to TestFlight / App Store Connect via fastlane pilot"
  lane :deploy do
    app_identifier = "com.bitpawos.app"
    ios_app_dir = File.expand_path("..", __dir__)
    xcodeproj_path = File.join(ios_app_dir, "App.xcodeproj")
    output_dir = File.join(ios_app_dir, "build")
    ipa_path = File.join(output_dir, "PawNailJobs.ipa")

    # 1. Create and unlock a temporary keychain on CI runners so codesign never blocks on GUI prompts
    setup_ci if ENV["CI"]

    # 2. Validate and authenticate with App Store Connect API using GitHub Secrets
    key_id = ENV["APP_STORE_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_ISSUER_ID"].to_s.strip
    raw_key = ENV["APP_STORE_PRIVATE_KEY"].to_s.strip

    UI.user_error!("Missing APP_STORE_KEY_ID secret") if key_id.empty?
    UI.user_error!("Missing APP_STORE_ISSUER_ID secret") if issuer_id.empty?
    UI.user_error!("Missing APP_STORE_PRIVATE_KEY secret") if raw_key.empty?

    is_base64 = !raw_key.include?("BEGIN PRIVATE KEY")
    key_content = is_base64 ? raw_key : raw_key.gsub("\\n", "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64,
      duration: 1200,
      in_house: false
    )

    # 3. Import the ONE persistent Apple Distribution certificate into the CI keychain.
    #    `cert` used to run here: on a fresh CI keychain it never finds a certificate with a
    #    local private key, so it created a NEW Apple Distribution certificate on every run
    #    until Apple's per-team limit made the lane fail. Export the existing certificate
    #    (Keychain Access > My Certificates > Apple Distribution > Export .p12), then set the
    #    GitHub secrets IOS_DIST_P12_BASE64 (base64 of the .p12) and IOS_DIST_P12_PASSWORD.
    #    Local runs (no CI) use the certificate already in the login keychain.
    if ENV["CI"]
      p12_base64 = ENV["IOS_DIST_P12_BASE64"].to_s.strip
      UI.user_error!("Missing IOS_DIST_P12_BASE64 secret (Apple Distribution certificate .p12, base64)") if p12_base64.empty?
      p12_path = File.join(Dir.tmpdir, "pawnail_distribution.p12")
      begin
        File.binwrite(p12_path, Base64.decode64(p12_base64))
        import_certificate(
          certificate_path: p12_path,
          certificate_password: ENV["IOS_DIST_P12_PASSWORD"].to_s,
          keychain_name: "fastlane_tmp_keychain",
          keychain_password: ""
        )
      ensure
        File.delete(p12_path) if File.exist?(p12_path)
      end
    end

    # App Store provisioning profile: reuse the existing one when it still matches the
    # installed certificate, create it only when missing/expired (no `force`).
    sigh(
      api_key: api_key,
      app_identifier: app_identifier
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = ENV["sigh_#{app_identifier}_appstore_team-id"] ||
              FastlaneCore::ProvisioningProfile.parse(profile_path)["TeamIdentifier"]&.first

    UI.user_error!("Could not resolve Apple Developer Team ID from provisioning profile") if team_id.to_s.strip.empty?

    # 4. Determine monotonically increasing build number so TestFlight never rejects duplicate builds
    next_build = (ENV["GITHUB_RUN_NUMBER"] || "1").to_i
    begin
      latest_tf = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: app_identifier,
        initial_build_number: 0
      )
      next_build = [latest_tf + 1, next_build].max
    rescue => ex
      UI.important("Could not query latest TestFlight build number (#{ex.message}); using build #{next_build}")
    end

    # 4b. Marketing version (CFBundleShortVersionString). Once a version is approved its
    #     train closes, so each store release needs a new one: run the workflow with the
    #     app_version input (APP_VERSION), e.g. 1.2.0. Empty = MARKETING_VERSION from the project.
    app_version = ENV["APP_VERSION"].to_s.strip
    unless app_version.empty? || app_version.match?(/\A\d+\.\d+(\.\d+)?\z/)
      UI.user_error!("APP_VERSION must look like 1.1.0 (got '#{app_version}')")
    end
    version_xcargs = "CURRENT_PROJECT_VERSION=#{next_build}"
    version_xcargs += " MARKETING_VERSION=#{app_version}" unless app_version.empty?
    UI.message("Building version #{app_version.empty? ? '(MARKETING_VERSION from project)' : app_version} (#{next_build})")

    # 5. Ensure shared Xcode scheme exists (Capacitor projects created outside Xcode may lack .xcscheme)
    recreate_schemes(project: xcodeproj_path)

    # 6. Apply manual App Store signing settings onto App.xcodeproj
    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj_path,
      team_id: team_id,
      targets: ["App"],
      bundle_identifier: app_identifier,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    # 7. Archive and export signed .ipa (Capacitor 8 uses Swift Package Manager via App.xcodeproj)
    build_app(
      project: xcodeproj_path,
      scheme: "App",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      xcargs: version_xcargs,
      output_directory: output_dir,
      output_name: "PawNailJobs.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          app_identifier => profile_name
        }
      }
    )

    # 8. Upload .ipa to TestFlight / App Store Connect via fastlane pilot
    pilot(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Alias for deploy lane"
  lane :beta do
    deploy
  end
end
