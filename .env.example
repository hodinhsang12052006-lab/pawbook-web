# -----------------------------------------------------------------------------
# PAWBOOK ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to a new file named `.env` and fill in your credentials.
# -----------------------------------------------------------------------------

# NEXTAUTH SETUP
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=pawbook-nextauth-secret-key-321-go
NEXTAUTH_URL=https://www.bitpawos.com

# CLOUDINARY STORAGE CONFIGURATION
# Find these keys in your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# DATABASE PATH (Optional override, default is file:./dev.db in SQLite)
# DATABASE_URL=file:./dev.db

# WEBHOOK SECURITY KEYS
CRAWLER_KEY=pawbook-crawler-secret-key-123

# TURSO CLOUD DATABASE CONFIGURATION (For Vercel deployment)
# TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
# TURSO_AUTH_TOKEN=your_auth_token_here

# ZEGOCLOUD INTEGRATION FOR VIDEO CALLS
NEXT_PUBLIC_ZEGO_APP_ID=your_zegocloud_app_id_here
NEXT_PUBLIC_ZEGO_SERVER_SECRET=your_zegocloud_server_secret_here

# SUPPORT CONTACT (shown on Support, Privacy, Terms, the official profile and password reset)
NEXT_PUBLIC_SUPPORT_EMAIL=support@bitpawsoftware.com

# -----------------------------------------------------------------------------
# JOBS BOARD
# NOTHING BELOW IS REQUIRED. With none of these set, the group bot keeps working exactly as before:
# /api/ingest/jobs and /api/jobs/sync accept posts with the existing INGEST_KEY, and the jobs show on the board
# with the salon's phone, "Call now" and the label "Shared from PawNail community groups".
# Put real values only in Vercel env, never in code or logs.
# -----------------------------------------------------------------------------

# Group bot (posts from the PawNail community Facebook groups). Uses the existing INGEST_KEY - no new setting.
# EMERGENCY STOP ONLY: INGEST_AGGREGATED=off makes both endpoints answer 410 INGEST_OFF. Any other value, or not
# setting it at all, means "accept". Remove the variable (and Redeploy) to accept again.
# INGEST_AGGREGATED=off
# The admin page warns when no new group post arrived for 24 hours (usually the bot needs a fresh Facebook login).

# Self-posts auto-hide JOB_TTL_DAYS after posting unless renewed; posts from before the rollout count from
# JOB_TTL_ROLLOUT (default 2026-11-07). Set it to the real deploy date if this ships later.
# JOB_TTL_DAYS=30
# JOB_TTL_ROLLOUT=2026-11-07T00:00:00Z

# ---- OPTIONAL EXTRA: partner job feeds (lib/jobFeeds/config.ts). ALL OFF BY DEFAULT. ----
# Skip this whole block unless you sign up with Adzuna / Careerjet. While they are off, nothing depends on the
# ExternalJob table: the board / job APIs never read it, and the cron + admin status card treat a missing table as
# "not set up". So the SQL file below is NOT needed to deploy - only before turning Adzuna on.
#
# Daily cron /api/cron/external-jobs (vercel.json) is rejected without CRON_SECRET (harmless while feeds are off).
# The purge of stored Adzuna rows after switching EXTERNAL_JOBS_ADZUNA off also runs in this cron,
# so it needs CRON_SECRET set. To purge at once when a licence ends:
#   npx tsx scripts/apply-sql.ts prisma/sql/2026-11-07_external_jobs_restore.sql
# CRON_SECRET=

# Adzuna (stored in table ExternalJob). FIRST create the table once:
#   npx tsx scripts/apply-sql.ts prisma/sql/2026-11-07_external_jobs.sql
# The 14-day trial key is ONLY for checking coverage/quality. With flag + keys but no licence, the cron fetches
# for an admin-only coverage check and nothing is shown publicly. Public display ALSO needs ADZUNA_LICENSE_REF
# (commercial licence id/date), because PawNail is a paid product.
# EXTERNAL_JOBS_ADZUNA=off
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_LICENSE_REF=
# ADZUNA_ATTRIBUTION_LABEL=Jobs by Adzuna   # exact wording required by the licence, if different

# Careerjet (live search per visitor, nothing stored, no table needed). The button stays hidden until Careerjet
# confirms the display / attribution / caching terms in writing: put that confirmation's date or reference here.
# EXTERNAL_JOBS_CAREERJET=off
# CAREERJET_API_KEY=
# CAREERJET_TERMS_CONFIRMED=

# If a partner pays PawNail per click, show "PawNail may earn a referral fee" (FTC / ACCC):
# EXTERNAL_JOBS_REFERRAL_FEE=off

# ---- GIFs in chat (/api/gifs) — server-only keys, NEVER with a NEXT_PUBLIC_ prefix ----
# Without a valid key every GIF entry point (GIF tab, "+" menu item, "Search GIFs for …") is hidden.
# GIPHY: developers.giphy.com → Create an App → API. A beta key allows ~100 calls/hour for ALL users together —
# apply for a Production key before launch.
# GIPHY_API_KEY=
# GIPHY_RATING=g            # g (default) or pg
# Tenor (Google) is used only when GIPHY_API_KEY is empty:
# TENOR_API_KEY=
# TENOR_CLIENT_KEY=pawnail
