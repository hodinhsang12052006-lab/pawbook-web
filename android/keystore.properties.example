# Copy to android/keystore.properties (gitignored, never commit it) and fill in on the build machine.
# storeFile is relative to android/app/. Use the upload key that Play Console > Test and release >
# App integrity > "Upload key certificate" shows (its SHA-1 must match). Keep a backup of the
# .keystore file and these passwords outside this laptop: a lost upload key needs a Play reset.
storeFile=pawos-release.keystore
storePassword=
keyAlias=pawos
keyPassword=
