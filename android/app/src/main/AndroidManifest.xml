<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: link bitpawos.com (email báo việc, link chia sẻ tin/tiệm/mẫu)
                 mở thẳng trong app. Chỉ host www (domain trần 308 sang www, làm hỏng xác minh).
                 KHÔNG thêm /api hay /auth: callback đăng nhập OAuth phải ở lại trình duyệt.
                 Cần https://www.bitpawos.com/.well-known/assetlinks.json chứa SHA-256 của
                 khoá ký app (Play Console > App integrity). JS xử lý link ở
                 components/NativeAppBridge.tsx (hosted mode không tự điều hướng). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.bitpawos.com" />
                <data android:pathPrefix="/jobs" />
                <data android:pathPrefix="/salons" />
                <data android:pathPrefix="/designs" />
                <data android:pathPrefix="/profile" />
                <data android:pathPrefix="/messages" />
                <data android:pathPrefix="/tryon" />
                <data android:pathPrefix="/trends" />
                <data android:pathPrefix="/r/" />
                <!-- URL tiếng Việt (/vi/…) cũng mở trong app — Google lập chỉ mục cả 2 bản. -->
                <data android:pathPrefix="/vi/jobs" />
                <data android:pathPrefix="/vi/salons" />
                <data android:pathPrefix="/vi/designs" />
                <data android:pathPrefix="/vi/profile" />
                <data android:pathPrefix="/vi/messages" />
                <data android:pathPrefix="/vi/tryon" />
                <data android:pathPrefix="/vi/trends" />
                <data android:pathPrefix="/vi/menu" />
                <data android:pathPrefix="/menu" />
            </intent-filter>
        </activity>

        <!-- Cửa sổ bong bóng chat (Android 11+, ChatNotifications): hoạt động riêng, không phải
             BridgeActivity (xem BubbleActivity.java). Hệ thống yêu cầu resizeable + allowEmbedded;
             documentLaunchMode="always": mỗi bong bóng là một tác vụ riêng. Không export: chỉ
             PendingIntent của app mở được. -->
        <activity
            android:name=".BubbleActivity"
            android:label="@string/title_activity_bubble"
            android:theme="@style/AppTheme.Bubble"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <!-- Nhận MỌI tin FCM: tự vẽ thông báo chat kiểu Messenger, tin khác giữ hành vi plugin
             (PawNailMessagingService kế thừa service của plugin). -->
        <service
            android:name=".PawNailMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Gỡ service gốc của @capacitor/push-notifications: 2 service cùng nghe MESSAGING_EVENT
             thì chỉ 1 cái (không đoán trước được) nhận tin. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- Nút "Trả lời" / "Đánh dấu đã đọc" / vuốt bỏ trên thông báo chat. -->
        <receiver
            android:name=".ChatActionReceiver"
            android:exported="false" />

        <!-- Tin "notification" do FCM tự vẽ (app ở nền: tin không phải chat, bản máy chủ cũ):
             icon trắng thanh trạng thái, màu cam thương hiệu, kênh mặc định "general". -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_pawnail" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/pn_notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: phải có quyền này thì thông báo đẩy (việc gấp, tin nhắn) mới hiện. Thư viện
         Firebase thường tự gộp vào, khai rõ ở đây cho chắc. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Tải ảnh portfolio: input[type=file accept="image/*,video/*"] mở
         camera hoặc thư viện qua bộ chọn file gốc của hệ điều hành. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Cuộc gọi thoại/video WebRTC trong CallManager.tsx gọi
         getUserMedia({audio:true,...}) — thiếu quyền này thì WebView từ
         chối truy cập mic, cuộc gọi thoại câm lặng thất bại (không crash,
         không log lỗi rõ ràng, chỉ đơn giản là không nghe được gì). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- BridgeWebChromeClient của Capacitor xin MODIFY_AUDIO_SETTINGS cùng lúc với
         RECORD_AUDIO khi trang gọi getUserMedia({audio}); thiếu khai báo thì nó từ chối
         mic. Quyền "normal": không hiện hộp thoại, không cần tờ khai Play. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Android 13+ KHÔNG cần READ_MEDIA_IMAGES/VIDEO: chọn ảnh qua bộ chọn file/Photo Picker
         của hệ thống (input type=file) không cần quyền. Khai 2 quyền đó thì Google Play bắt
         nộp tờ khai "Photo and video permissions" và hay từ chối app chỉ thỉnh thoảng tải ảnh. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- KHÔNG khai báo ACCESS_FINE/COARSE_LOCATION: tính năng "Chấm công
         GPS" chỉ tồn tại dưới dạng copy quảng cáo trong khảo sát 5 câu
         (lib/ownerSurvey.ts, tag NEED_GPS_REFUND) và 1 bong bóng chat tĩnh
         (ATTENDANCE) — không có lệnh gọi navigator.geolocation/Capacitor
         Geolocation nào trong toàn bộ codebase. Khai báo quyền vị trí
         (permission nhạy cảm nhất, bắt buộc Play Console yêu cầu form giải
         trình + video minh hoạ riêng) cho 1 tính năng không có thật là rủi
         ro bị Google Play từ chối/khoá app thẳng — không phải rủi ro lý
         thuyết. Nếu sau này xây tính năng GPS chấm công thật, thêm lại 2
         dòng quyền này + Usage Description tương ứng lúc đó. -->
</manifest>
